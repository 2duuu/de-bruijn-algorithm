        {
          "length": 25,
          "copies": 3
        },
        {
          "length": 40,
          "copies": 3
        },
        {
          "length": 60,
          "copies": 2
        }
      ]
    },
    "read_length": 100,
    "coverage": 30,
    "error_rate": 0.001
  },
  "x": {
    "param": "k",
    "values": [
      7,
      9,
      11,
      13,
      15,
      17,
      19,
      21,
      25,
      31,
      41,
      51,
      61,
      71,
      81,
      87,
      91,
      95
    ]
  },
  "series": {
